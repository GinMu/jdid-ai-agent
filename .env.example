# 规划器:fake(默认,离线) | langchain(真实模型)
DID_AI_PLANNER=fake

# 真实模型:deepseek 走 langchain-deepseek(ChatDeepSeek)
DID_AI_MODEL=deepseek:deepseek-flash   # 服务端支持:deepseek-flash / deepseek-v4-pro
DID_AI_BASE_URL=                 # 留空 = langchain-deepseek 默认端点;本地桩测试才填
DID_AI_API_KEY=                  # 也可用环境变量 DEEPSEEK_API_KEY
DID_AI_TEMPERATURE=0

# 策略
DID_AI_MAX_TURNS=6               # 一轮对话最多几次工具往返
DID_AI_RATE_LIMIT_PER_MIN=30     # 每个会话每分钟的 /chat 次数
DID_AI_AUDIT_SIZE=200            # 内存审计环形缓冲条数
